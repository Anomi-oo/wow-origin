# EdgeOne Makers 环境变量示例。在控制台或 `edgeone makers env set` 中配置。
# 不要提交真实值。

# 管理后台密码；留空则管理员功能关闭
ADMIN_MANAGEMENT_PASSWORD=

# 构建时下载并内联洛雪全局音源（也可复用 CF_LX_SOURCE_URL）
EDGEONE_LX_SOURCE_URL=

# EdgeOne Blob 的 store 名称；首次 getStore() 会自动创建命名空间
EDGEONE_BLOB_STORE=wow-origin

# 设为 1 时 Blob 不可用会直接报错，而不是回退到本地文件/内存
EDGEONE_REQUIRE_BLOB=0

# 本地开发/无 Blob 时的账号文件；云端通常不需要
EDGEONE_ACCOUNTS_FILE=data/edgeone-accounts.json

# CORS 源；生产建议填写具体域名
CORS_ALLOW_ORIGIN=*

# 仅在函数环境之外手动调用 Blob SDK 时需要；EdgeOne 部署会自动注入
# PAGES_PROJECT_ID=
# PAGES_BLOB_DEPLOY_CREDENTIAL=
