{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wow",
  "version": "1.0.1",
  "identifier": "com.anomi-oo.woworigin",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Wow",
        "width": 1060,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-src http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/node"],
    "resources": {
      "../desktop-runtime/": "server-runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
