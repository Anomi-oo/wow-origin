# 服务配置
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# 日志配置
# 可选值: debug, info, warn, error
LOG_LEVEL=info

# CORS 配置
CORS_ALLOW_ORIGIN=*

# 洛雪自定义源（可选）
# 按 LX_SOURCE_URL、LX_SOURCE_URL0 至 LX_SOURCE_URL9 的顺序调用
# LX_SOURCE_URL=https://example.com/lx-source-primary.js
# LX_SOURCE_URL0=https://example.com/lx-source-backup.js
