{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "types": ["node"]
  },
  "include": [
    "./**/*.ts",
    "./generated/*.js",
    "../types/**/*.d.ts",
    "../node_modules/@cloudflare/workers-types/index.d.ts"
  ],
  "exclude": ["../dist", "../tests"]
}
