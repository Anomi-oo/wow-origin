# 服务配置
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# 日志配置
# 可选值: debug, info, warn, error
LOG_LEVEL=info

# CORS配置
# 允许所有源（开发环境）
CORS_ALLOW_ORIGIN=*

# 允许特定源（生产环境推荐）
# CORS_ALLOW_ORIGIN=https://example.com

# 允许多个源（使用逗号分隔）
# CORS_ALLOW_ORIGIN=https://example.com,https://app.example.com

# 洛雪自定义源（可选，仅在账号 cookie 为空时用于获取音频 URL）
# 按 LX_SOURCE_URL、LX_SOURCE_URL0 至 LX_SOURCE_URL9 的顺序调用
# LX_SOURCE_URL=https://example.com/lx-source-primary.js
# LX_SOURCE_URL0=https://example.com/lx-source-backup.js
